{
  "name": "chocobones-ts",
  "version": "0.1.0",
  "description": "2D/3D character puppet creator and skeletal animation studio in TypeScript (Node + pnpm + Slint + WebGPU)",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "gl-matrix": "^3.4.3",
    "slint-ui": "^1.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@webgpu/types": "^0.1.51",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^3.0.5"
  }
}
