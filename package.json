{
  "name": "chocobones-ts",
  "version": "0.1.0",
  "description": "2D/3D character puppet creator and skeletal animation studio in TypeScript (Bun + Slint + WebGPU)",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "gl-matrix": "^3.4.3",
    "slint-ui": "^1.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@webgpu/types": "^0.1.51",
    "typescript": "^5.6.3"
  }
}
