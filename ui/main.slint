// chocoBones — chrome contínuo, neutro e orientado ao documento.
import { VerticalBox, HorizontalBox, ScrollView, Slider } from "std-widgets.slint";
import { StudioPalette, StudioButton, PanelTitle, StudioScrub, StudioSwatch, StudioField } from "studio-controls.slint";
export struct JointRow { id: string, name: string, parent: string, color: string }
export struct LayerRow { id: string, name: string, joint: string, visible: bool, locked: bool, opacity: float }
export struct PinRow { id: string, name: string, locked: bool }
export struct ToolEntry { id: string, label: string, icon: image }
export component MainWindow inherits Window {
    title: "chocoBones — Estúdio de personagens";
    preferred-width: 1400px;
    preferred-height: 900px;
    min-width: 760px;
    min-height: 560px;
    default-font-family: "Inter";
    default-font-size: 12px;
    background: StudioPalette.bg;
    in-out property <string> theme_mode <=> StudioPalette.theme;
    in-out property <string> accent_name <=> StudioPalette.accent-name;
    out property <color> col_bg: StudioPalette.bg;
    out property <color> col_surface: StudioPalette.surface;
    out property <color> col_surface_alt: StudioPalette.raised;
    out property <color> col_field: StudioPalette.field;
    out property <color> col_border: StudioPalette.border;
    out property <color> col_text: StudioPalette.text;
    out property <color> col_text_muted: StudioPalette.muted;
    out property <color> col_accent: StudioPalette.accent;
    out property <color> col_accent_text: StudioPalette.on-accent;
    out property <bool> compact_layout: root.width < 1100px;
    out property <bool> short_layout: root.height < 720px;
    out property <length> viewport_width: stage.width;
    out property <length> viewport_height: stage.height;
    out property <length> inspector_width: root.active_workspace == "Foco" ? 0px : root.compact_layout ? 232px : 268px;
    in-out property <bool> appearance_open: false;
    in-out property <string> dock_tab: "Elementos";
    out property <string> tool_label: active_tool == "Move" ? "Mover" : active_tool == "Rotate" ? "Girar" :
        active_tool == "Scale" ? "Escala" : active_tool == "Pivot" ? "Pivô" : active_tool == "Joint" ? "Juntas" :
        active_tool == "CreateBone" ? "Criar osso" : active_tool == "Pose" ? "Pose" : active_tool == "Pin" ? "Pinos de deformação" : "Pesos";
    property <[ToolEntry]> tools: [
        {id: "Move", label: "Mover", icon: @image-url("../assets/icons/phosphor/svg/regular/cursor.svg")},
        {id: "Rotate", label: "Girar", icon: @image-url("../assets/icons/phosphor/svg/regular/arrow-u-up-left.svg")},
        {id: "Scale", label: "Escala", icon: @image-url("../assets/icons/phosphor/svg/regular/arrows-out-simple.svg")},
        {id: "Pivot", label: "Pivô", icon: @image-url("../assets/icons/phosphor/svg/regular/crosshair.svg")},
        {id: "Joint", label: "Juntas", icon: @image-url("../assets/icons/phosphor/svg/regular/bone.svg")},
        {id: "CreateBone", label: "Criar osso", icon: @image-url("../assets/icons/phosphor/svg/regular/plus.svg")},
        {id: "Pose", label: "Pose", icon: @image-url("../assets/icons/phosphor/svg/regular/person-arms-spread.svg")},
        {id: "Pin", label: "Pinos", icon: @image-url("../assets/icons/phosphor/svg/regular/push-pin.svg")},
        {id: "Weight", label: "Pesos", icon: @image-url("../assets/icons/phosphor/svg/regular/paint-brush.svg")}
    ];
    in-out property <bool> has_sprite: false;
    in-out property <bool> import_busy: false;
    in-out property <string> png_path: "";
    in-out property <float> canvas_width: 512;
    in-out property <float> canvas_height: 512;
    in-out property <float> mesh_rows: 16;
    in-out property <float> mesh_cols: 16;
    in-out property <float> alpha_threshold: 10;
    in-out property <float> mesh_triangles: 0;
    in-out property <float> mesh_vertices: 0;
    in-out property <bool> refine_edges: false;
    in-out property <float> edge_size: 4;
    in-out property <bool> mesh_budget_limited: false;
    in-out property <string> deformation: "MLS";
    in-out property <bool> show_mesh: true;
    in-out property <bool> show_skeleton: true;
    in-out property <bool> onion_skin: false;
    in-out property <bool> snap_pins: true;
    in-out property <float> motion_amplitude: 12;
    in-out property <float> motion_frequency: 0.625;
    in-out property <string> motion_preset: "breath";
    in-out property <[PinRow]> pins_list;
    in-out property <string> selected_pin_id;
    in-out property <string> selected_pin_name;
    in-out property <bool> selected_pin_locked;
    in-out property <float> selected_pin_radius: 0;
    in-out property <float> selected_pin_strength: 1;
    in-out property <bool> performance_armed: false;
    callback choose_png();
    callback import_png_file(string);
    callback fit_canvas();
    callback rebuild_mesh();
    callback set_deformation(string);
    callback auto_pins();
    callback set_sprite_parameter(string, string);
    callback toggle_sprite_overlay(string);
    callback choose_pin(string);
    callback lock_selected_pin();
    callback remove_selected_pin();
    callback apply_pin_motion(string);
    callback key_pin_pose();
    callback arm_performance();
    callback export_spritesheet();
    // =========================================================================
    // ESTADO DA APLICAÇÃO
    // =========================================================================
    in-out property <string> active_workspace: "Rig"; // "Montagem", "Rig", "Animacao", "3D", "Foco"
    in-out property <string> active_tool: "Move";     // Move, Rotate, Scale, Pivot, Joint, Bone, Pose, Box, Lasso, Pin, Weight, Eraser
    in-out property <string> viewport_mode: "2D";
    in-out property <image> viewport_frame;
    in-out property <string> status_text: "Pronto — chocoBones Studio Ativo";
    in-out property <float> zoom_level: 1.0;
    in-out property <string> element_tab: "Juntas";   // "Juntas" ou "Camadas"
    in-out property <string> search_filter: "";

    // Coleções Reativas
    in-out property <[JointRow]> joints_list;
    in-out property <[LayerRow]> layers_list;

    // Junta Selecionada
    in-out property <string> selected_joint_id: "root";
    in-out property <string> selected_joint_name: "Centro / quadril";
    in-out property <string> selected_joint_parent: "";
    in-out property <float> selected_joint_x: 256.0;
    in-out property <float> selected_joint_y: 300.0;
    in-out property <float> selected_joint_angle: 0.0;
    in-out property <string> selected_joint_color: "#eab308";
    in-out property <bool> ik_enabled: false;

    // Camada Selecionada
    in-out property <string> selected_layer_id: "";
    in-out property <string> selected_layer_name: "";
    in-out property <float> selected_layer_opacity: 1.0;

    // Linha do Tempo
    in-out property <float> timeline_time: 0.0;
    in-out property <float> timeline_duration: 1.6;
    in-out property <bool> is_playing: true;
    in-out property <string> active_clip_name: "idle";
    in-out property <string> editor_mode: "Animate";

    // Callbacks do Navegador e Ações de Projeto
    callback change_workspace(string);
    callback set_viewport_mode(string);
    callback set_editor_mode(string);
    callback toggle_editor_mode();
    callback change_theme(string);
    callback change_accent(string);
    callback select_tool(string);
    callback set_element_tab(string);
    callback undo();
    callback redo();
    callback new_project();
    callback save_project();
    callback load_project();
    callback export_png();

    // Callbacks de Juntas & Rig
    callback select_joint(string);
    callback add_joint();
    callback remove_joint(string);
    callback update_joint_pos(string, float, float);
    callback update_joint_angle(string, float);
    callback set_rig_preset(string);
    callback toggle_ik();

    // Callbacks de Camadas & Montagem
    callback select_layer(string);
    callback add_layer();
    callback remove_layer(string);
    callback toggle_layer_visibility(string);
    callback update_layer_opacity(string, float);
    callback move_layer(string, float);
    callback move_selected_layer_up();
    callback move_selected_layer_down();
    callback remove_selected_layers();
    callback select_layer_range(string, bool);

    // Callbacks de Animação
    callback toggle_play();
    callback timeline_seek(float);
    callback select_clip(string);
    callback reset_to_rest();

    // Callbacks de Interação com a Viewport
    callback viewport_mouse_down(float, float);
    callback viewport_mouse_up(float, float);
    callback viewport_mouse_move(float, float);
    callback viewport_scroll(float);
    callback zoom_in();
    callback zoom_out();
    callback reset_view();
    callback handle_key(string, bool) -> string;

    // Callbacks de Pinos MLS
    callback add_pin(string, float, float) -> string;
    callback delete_pin(string) -> bool;
    callback select_pin(string);
    callback toggle_pin_lock(string) -> bool;
    callback reset_pin(string);
    callback set_pin_anchor(string, string, string);
    callback set_pin_influence(string, float, float, float);

    VerticalLayout {
        spacing: 0px;
        // Personas e ações globais. Somente o espaço ativo usa a cápsula de acento.
        Rectangle {
            height: 40px; background: StudioPalette.surface;
            HorizontalLayout {
                padding-left: 8px; padding-right: 8px; spacing: 3px;
                Image { width: 22px; height: 22px; source: @image-url("../assets/icons/phosphor/svg/regular/bone.svg"); colorize: StudioPalette.text; }
                if !root.compact_layout: Text { text: "chocoBones"; color: StudioPalette.text; font-weight: 600; font-size: 13px; vertical-alignment: center; }
                Rectangle { width: 10px; }
                StudioButton { label: "Montagem"; pill: true; active: root.active_workspace == "Montagem"; clicked => { root.change_workspace("Montagem"); } }
                StudioButton { label: "Rig"; pill: true; active: root.active_workspace == "Rig"; clicked => { root.change_workspace("Rig"); } }
                StudioButton { label: "Animação"; pill: true; active: root.active_workspace == "Animacao"; clicked => { root.change_workspace("Animacao"); } }
                StudioButton { label: "Foco"; pill: true; active: root.active_workspace == "Foco"; clicked => { root.change_workspace("Foco"); } }
                Rectangle { horizontal-stretch: 1; }
                StudioButton { has-icon: true; icon: @image-url("../assets/icons/phosphor/svg/regular/arrow-u-up-left.svg"); description: "Desfazer"; clicked => { root.undo(); } }
                StudioButton { has-icon: true; icon: @image-url("../assets/icons/phosphor/svg/regular/arrow-u-up-right.svg"); description: "Refazer"; clicked => { root.redo(); } }
                Rectangle { width: 1px; height: 18px; background: StudioPalette.border; }
                StudioButton { has-icon: true; icon: @image-url("../assets/icons/phosphor/svg/regular/file-plus.svg"); description: "Novo projeto"; clicked => { root.new_project(); } }
                StudioButton { has-icon: true; icon: @image-url("../assets/icons/phosphor/svg/regular/folder-open.svg"); description: "Abrir projeto"; clicked => { root.load_project(); } }
                StudioButton { has-icon: true; icon: @image-url("../assets/icons/phosphor/svg/regular/floppy-disk.svg"); description: "Salvar projeto"; clicked => { root.save_project(); } }
                StudioButton { has-icon: true; icon: @image-url("../assets/icons/phosphor/svg/regular/image.svg"); description: "Importar PNG"; enabled: !root.import_busy; clicked => { root.choose_png(); } }
                StudioButton { label: root.compact_layout ? "PNG" : "Exportar PNG"; quiet: false; clicked => { root.export_png(); } }
                StudioButton { has-icon: true; icon: @image-url("../assets/icons/phosphor/svg/regular/gear.svg"); description: "Aparência"; active: root.appearance_open; clicked => { root.appearance_open = !root.appearance_open; } }
            }
            Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: StudioPalette.border; }
        }
        // Opções pertinentes ao fluxo atual. Os presets ficam no inspetor.
        Rectangle {
            height: 34px; background: StudioPalette.bg;
            HorizontalLayout {
                padding-left: 10px; padding-right: 8px; spacing: 5px;
                Text { text: root.tool_label; font-size: 11px; font-weight: 600; color: StudioPalette.text; vertical-alignment: center; }
                Rectangle { width: 1px; height: 16px; background: StudioPalette.border; }
                StudioButton { label: "Repouso"; height: 24px; active: root.editor_mode == "Setup"; clicked => { root.set_editor_mode("Setup"); } }
                StudioButton { label: "Pose"; height: 24px; active: root.editor_mode == "Animate"; clicked => { root.set_editor_mode("Animate"); } }
                if !root.has_sprite && (root.active_workspace == "Rig" || root.active_workspace == "Animacao"): StudioButton { label: root.ik_enabled ? "IK ligado" : "IK desligado"; height: 24px; active: root.ik_enabled; clicked => { root.toggle_ik(); } }
                if root.active_workspace == "Montagem": StudioButton { label: "+ Camada"; height: 24px; clicked => { root.add_layer(); } }
                StudioButton { label: "Puppet"; height: 24px; active: root.dock_tab == "Puppet"; clicked => { root.dock_tab = root.dock_tab == "Puppet" ? "Elementos" : "Puppet"; } }
                Rectangle { horizontal-stretch: 1; }
                if !root.compact_layout: Text { text: root.element_tab == "Juntas" ? root.selected_joint_name : root.selected_layer_name; color: StudioPalette.muted; font-size: 11px; vertical-alignment: center; }
                StudioButton { label: "2D"; height: 24px; active: root.viewport_mode == "2D"; clicked => { root.set_viewport_mode("2D"); } }
                StudioButton { label: "3D"; height: 24px; active: root.viewport_mode == "3D"; clicked => { root.set_viewport_mode("3D"); } }
                Rectangle { width: 1px; height: 16px; background: StudioPalette.border; }
                StudioButton { has-icon: true; icon: @image-url("../assets/icons/phosphor/svg/regular/minus.svg"); height: 24px; description: "Diminuir zoom"; clicked => { root.zoom_out(); } }
                StudioButton { label: round(root.zoom_level * 100) + "%"; height: 24px; description: "Restaurar vista"; clicked => { root.reset_view(); } }
                StudioButton { has-icon: true; icon: @image-url("../assets/icons/phosphor/svg/regular/plus.svg"); height: 24px; description: "Aumentar zoom"; clicked => { root.zoom_in(); } }
            }
        }
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: 40px; background: StudioPalette.surface;
                ScrollView {
                    width: parent.width - 1px; height: parent.height;
                    VerticalLayout {
                        padding: 4px; spacing: 3px;
                        for tool[i] in root.tools: StudioButton {
                            width: 30px; height: 32px;
                            has-icon: true; icon: tool.icon; description: tool.label;
                            active: root.active_tool == tool.id;
                            clicked => { root.select_tool(tool.id); }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                Rectangle { x: parent.width - 1px; width: 1px; height: 100%; background: StudioPalette.border; }
            }
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 27px; background: StudioPalette.surface;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px;
                        Text { text: "Personagem · " + (root.viewport_mode == "2D" ? "Palco 2D" : "Malha 3D"); color: StudioPalette.text; font-size: 11px; vertical-alignment: center; }
                        Text { text: root.active_workspace == "Animacao" ? "Clipe: " + root.active_clip_name : root.editor_mode == "Setup" ? "Editar estrutura de repouso" : "Editar pose"; color: StudioPalette.muted; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: StudioPalette.border; }
                }
                stage := Rectangle {
                    horizontal-stretch: 1; vertical-stretch: 1;
                    background: root.theme_mode == "Light" ? #bfc0c2 : root.theme_mode == "Dim" ? #2a2a2a : #171717;
                    Image { width: 100%; height: 100%; source: root.viewport_frame; image-fit: contain; }
                    stage-focus := FocusScope {
                        key-pressed(event) => {
                            if root.handle_key(event.text == Key.Delete ? "Delete" : event.text == Key.Backspace ? "Backspace" : event.text == Key.Home ? "Home" : event.text, event.modifiers.alt) != "none" { accept } else { reject }
                        }
                    }
                    TouchArea {
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down { stage-focus.focus(); root.viewport_mouse_down(self.mouse-x / 1px, self.mouse-y / 1px); }
                            if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { root.viewport_mouse_up(self.mouse-x / 1px, self.mouse-y / 1px); }
                        }
                        moved => { root.viewport_mouse_move(self.mouse-x / 1px, self.mouse-y / 1px); }
                        scroll-event(event) => { root.viewport_scroll(event.delta-y / 1px); accept }
                    }
                }
                if root.active_workspace == "Animacao": Rectangle {
                    height: root.short_layout ? 96px : 128px; background: StudioPalette.surface;
                    VerticalLayout {
                        spacing: 0px;
                        Rectangle {
                            height: 34px; background: StudioPalette.bg;
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 10px; spacing: 4px;
                                StudioButton { has-icon: true; icon: @image-url("../assets/icons/phosphor/svg/regular/skip-back.svg"); description: "Início do clipe"; clicked => { root.timeline_seek(0); } }
                                StudioButton { has-icon: true; icon: root.is_playing ? @image-url("../assets/icons/phosphor/svg/regular/pause.svg") : @image-url("../assets/icons/phosphor/svg/regular/play.svg"); active: root.is_playing; description: root.is_playing ? "Pausar" : "Reproduzir"; clicked => { root.toggle_play(); } }
                                StudioButton { label: "Repouso"; clicked => { root.reset_to_rest(); } }
                                Rectangle { width: 1px; height: 16px; background: StudioPalette.border; }
                                StudioButton { label: root.has_sprite ? "Respirar" : "Idle"; active: root.has_sprite ? root.active_clip_name == "Respiração" : root.active_clip_name == "idle"; clicked => { root.select_clip("idle"); } }
                                StudioButton { label: root.has_sprite ? "Passos" : "Walk"; active: root.has_sprite ? root.active_clip_name == "Caminhada" : root.active_clip_name == "walk"; clicked => { root.select_clip("walk"); } }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: round(root.timeline_time * 100) / 100 + " / " + root.timeline_duration + " s"; color: StudioPalette.text; font-size: 11px; vertical-alignment: center; }
                            }
                        }
                        Rectangle {
                            height: 23px;
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px;
                                for tick[i] in 9: Text { text: round(i * root.timeline_duration / 8 * 100) / 100 + ""; color: StudioPalette.muted; font-size: 10px; horizontal-alignment: i == 0 ? left : i == 8 ? right : center; vertical-alignment: center; }
                            }
                        }
                        StudioScrub { value: root.timeline_time; maximum: root.timeline_duration; changed(value) => { root.timeline_seek(value); } }
                        if !root.short_layout: HorizontalLayout {
                            padding-left: 10px; padding-right: 10px;
                            Text { text: "Animação esquelética"; font-size: 10px; color: StudioPalette.muted; }
                            Text { text: "Arraste para navegar · Espaço para reproduzir"; font-size: 10px; color: StudioPalette.muted; horizontal-alignment: right; }
                        }
                    }
                    Rectangle { x: 0px; y: 0px; height: 1px; width: 100%; background: StudioPalette.border; }
                }
            }
            if root.active_workspace != "Foco": Rectangle {
                width: root.inspector_width; background: StudioPalette.surface;
                VerticalLayout {
                    spacing: 0px;
                    // Em telas estreitas, seções dividem abas para preservar o palco.
                    Rectangle {
                        height: 30px; background: StudioPalette.bg;
                        HorizontalLayout {
                            padding-left: 4px; padding-right: 4px; spacing: 2px;
                            StudioButton { label: "Elementos"; height: 24px; active: root.dock_tab == "Elementos"; clicked => { root.dock_tab = "Elementos"; } }
                            StudioButton { label: "Inspetor"; height: 24px; active: root.dock_tab == "Inspetor"; clicked => { root.dock_tab = "Inspetor"; } }
                            StudioButton { label: "Puppet"; height: 24px; active: root.dock_tab == "Puppet"; clicked => { root.dock_tab = "Puppet"; } }
                        }
                    }
                    if root.dock_tab == "Puppet": ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 7px; padding: 8px;
                            PanelTitle { label: "Imagem e canvas"; detail: round(root.canvas_width) + "×" + round(root.canvas_height); }
                            HorizontalLayout {
                                spacing: 4px;
                                StudioButton { label: "Importar PNG"; quiet: false; enabled: !root.import_busy; clicked => { root.choose_png(); } }
                                StudioButton { label: "Enquadrar"; quiet: false; clicked => { root.fit_canvas(); } }
                            }
                            StudioField { description: "Caminho do PNG"; value <=> root.png_path; committed(value) => { root.import_png_file(value); } }
                            Text { text: "Cole um caminho PNG e pressione Enter."; font-size: 10px; color: StudioPalette.muted; }
                            PanelTitle { label: "Malha por transparência"; detail: round(root.mesh_vertices) + " v / " + round(root.mesh_triangles) + " t"; }
                            HorizontalLayout {
                                spacing: 5px;
                                Text { text: "Linhas"; color: StudioPalette.muted; font-size: 10px; vertical-alignment: center; }
                                StudioField { description: "Linhas da malha"; value: root.mesh_rows + ""; committed(value) => { root.set_sprite_parameter("rows", value); } }
                                Text { text: "Colunas"; color: StudioPalette.muted; font-size: 10px; vertical-alignment: center; }
                                StudioField { description: "Colunas da malha"; value: root.mesh_cols + ""; committed(value) => { root.set_sprite_parameter("cols", value); } }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                Text { text: "Limiar alfa"; color: StudioPalette.muted; font-size: 11px; vertical-alignment: center; }
                                StudioField { description: "Limiar alfa de 1 a 255"; value: root.alpha_threshold + ""; committed(value) => { root.set_sprite_parameter("alpha", value); } }
                                StudioButton { label: "Aplicar"; quiet: false; enabled: root.has_sprite; clicked => { root.rebuild_mesh(); } }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                StudioButton { label: "Refinar contorno"; active: root.refine_edges; clicked => { root.toggle_sprite_overlay("refine"); } }
                                StudioField { description: "Tamanho da célula no contorno, de 2 a 32 pixels; pressione Aplicar"; value: root.edge_size + ""; committed(value) => { root.set_sprite_parameter("edge", value); } }
                                Text { text: "px"; color: StudioPalette.muted; font-size: 10px; vertical-alignment: center; }
                            }
                            if root.mesh_budget_limited: Text { text: "Limite de vértices atingido; parte do contorno usa células maiores."; wrap: word-wrap; font-size: 10px; color: StudioPalette.muted; }
                            HorizontalLayout {
                                spacing: 4px;
                                StudioButton { label: "MLS"; active: root.deformation == "MLS"; enabled: root.has_sprite; clicked => { root.set_deformation("MLS"); } }
                                StudioButton { label: "ARAP"; active: root.deformation == "ARAP"; enabled: root.has_sprite; clicked => { root.set_deformation("ARAP"); } }
                            }
                            Text { text: root.deformation == "ARAP" ? "ARAP preserva formas locais. Pinos na malha são alvos exatos." : "MLS usa raio e peso para distribuir a influência dos pinos."; wrap: word-wrap; font-size: 10px; color: StudioPalette.muted; }
                            HorizontalLayout {
                                spacing: 3px;
                                StudioButton { label: "Malha"; active: root.show_mesh; clicked => { root.toggle_sprite_overlay("mesh"); } }
                                StudioButton { label: "Ossos"; active: root.show_skeleton; clicked => { root.toggle_sprite_overlay("skeleton"); } }
                                StudioButton { label: "Onion"; active: root.onion_skin; clicked => { root.toggle_sprite_overlay("onion"); } }
                            }
                            PanelTitle { label: "Pinos de deformação"; detail: root.pins_list.length + " pinos"; }
                            HorizontalLayout {
                                spacing: 4px;
                                StudioButton { label: "Sugerir pinos"; quiet: false; enabled: root.has_sprite; clicked => { root.auto_pins(); } }
                                StudioButton { label: "Snap alfa"; active: root.snap_pins; clicked => { root.toggle_sprite_overlay("snap"); } }
                            }
                            Text { text: "Repouso: clique para criar/mover. Pose: arraste para animar."; wrap: word-wrap; font-size: 10px; color: StudioPalette.muted; }
                            for pin[i] in root.pins_list: StudioButton {
                                label: pin.name; has-icon: true;
                                icon: pin.locked ? @image-url("../assets/icons/phosphor/svg/regular/lock.svg") : @image-url("../assets/icons/phosphor/svg/regular/push-pin.svg");
                                active: root.selected_pin_id == pin.id;
                                clicked => { root.choose_pin(pin.id); }
                            }
                            HorizontalLayout {
                                spacing: 3px;
                                StudioButton { label: root.selected_pin_locked ? "Destravar" : "Fixar âncora"; quiet: false; enabled: root.selected_pin_id != ""; clicked => { root.lock_selected_pin(); } }
                                StudioButton { has-icon: true; icon: @image-url("../assets/icons/phosphor/svg/regular/trash.svg"); description: "Remover pino"; enabled: root.selected_pin_id != ""; clicked => { root.remove_selected_pin(); } }
                            }
                            if root.selected_pin_id != "" && root.deformation == "MLS": HorizontalLayout {
                                spacing: 4px;
                                Text { text: "Raio"; color: StudioPalette.muted; font-size: 10px; vertical-alignment: center; }
                                StudioField { description: "Raio local; zero significa toda a malha"; value: root.selected_pin_radius + ""; committed(value) => { root.set_sprite_parameter("radius", value); } }
                                Text { text: "Peso"; color: StudioPalette.muted; font-size: 10px; vertical-alignment: center; }
                                StudioField { description: "Influência relativa entre zero e um"; value: root.selected_pin_strength + ""; committed(value) => { root.set_sprite_parameter("strength", value); } }
                            }
                            PanelTitle { label: "Movimento assistido"; detail: "Keyframes"; }
                            HorizontalLayout {
                                spacing: 5px;
                                Text { text: "Amplitude px"; font-size: 10px; color: StudioPalette.muted; vertical-alignment: center; }
                                StudioField { description: "Amplitude em pixels"; value: root.motion_amplitude + ""; committed(value) => { root.set_sprite_parameter("amplitude", value); } }
                                Text { text: "Hz"; font-size: 10px; color: StudioPalette.muted; vertical-alignment: center; }
                                StudioField { description: "Frequência em Hz"; value: root.motion_frequency + ""; committed(value) => { root.set_sprite_parameter("frequency", value); } }
                            }
                            HorizontalLayout {
                                spacing: 2px;
                                StudioButton { label: "Respirar"; quiet: false; enabled: root.has_sprite; clicked => { root.apply_pin_motion("breath"); } }
                                StudioButton { label: "Ondular"; quiet: false; enabled: root.has_sprite; clicked => { root.apply_pin_motion("sway"); } }
                                StudioButton { label: "Passos"; quiet: false; enabled: root.has_sprite; clicked => { root.apply_pin_motion("walk"); } }
                            }
                            Text { text: "Aplicar substitui o clipe ativo; Desfazer recupera o anterior."; color: StudioPalette.muted; font-size: 10px; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 3px;
                                StudioButton { label: "Gravar pose"; quiet: false; enabled: root.has_sprite; clicked => { root.key_pin_pose(); } }
                                StudioButton { label: "Gravar gesto"; active: root.performance_armed; enabled: root.has_sprite; clicked => { root.arm_performance(); } }
                            }
                            StudioButton { label: "Exportar spritesheet · 8 quadros"; quiet: false; enabled: root.has_sprite; clicked => { root.export_spritesheet(); } }
                            Text { text: "PNG e spritesheet: transparência, sem grade, pinos ou ossos."; color: StudioPalette.muted; font-size: 10px; wrap: word-wrap; }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    if root.dock_tab != "Puppet" && (!root.compact_layout || root.dock_tab == "Elementos"): VerticalLayout {
                        spacing: 0px;
                        PanelTitle { label: "Elementos"; detail: root.element_tab == "Juntas" ? root.joints_list.length + " juntas" : root.layers_list.length + " camadas"; }
                        HorizontalLayout {
                            padding: 5px; spacing: 2px;
                            StudioButton { label: "Camadas"; active: root.element_tab == "Camadas"; clicked => { root.set_element_tab("Camadas"); } }
                            StudioButton { label: "Juntas"; active: root.element_tab == "Juntas"; clicked => { root.set_element_tab("Juntas"); } }
                            Rectangle { horizontal-stretch: 1; }
                            StudioButton { has-icon: true; icon: @image-url("../assets/icons/phosphor/svg/regular/plus.svg"); description: root.element_tab == "Juntas" ? "Adicionar junta" : "Adicionar camada"; clicked => { if root.element_tab == "Juntas" { root.add_joint(); } else { root.add_layer(); } } }
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            min-height: 110px;
                            preferred-height: root.compact_layout ? 330px : root.short_layout ? 150px : 270px;
                            VerticalLayout {
                                spacing: 0px;
                                if root.element_tab == "Juntas": VerticalLayout {
                                    spacing: 0px;
                                    for j[i] in root.joints_list: Rectangle {
                                        height: 27px;
                                        background: j.id == root.selected_joint_id ? StudioPalette.selection : row-touch.has-hover ? StudioPalette.raised : StudioPalette.surface;
                                        row-touch := TouchArea { clicked => { root.select_joint(j.id); } }
                                        HorizontalLayout {
                                            padding-left: j.parent == "" ? 10px : j.parent == "root" ? 18px : 28px;
                                            padding-right: 5px; spacing: 6px;
                                            Image { width: 12px; height: 12px; source: @image-url("../assets/icons/phosphor/svg/regular/bone.svg"); colorize: StudioPalette.muted; }
                                            Text { text: j.name; horizontal-stretch: 1; overflow: elide; font-size: 11px; color: StudioPalette.text; vertical-alignment: center; }
                                            if j.id != "root": StudioButton { has-icon: true; height: 24px; icon: @image-url("../assets/icons/phosphor/svg/regular/x.svg"); description: "Remover " + j.name; clicked => { root.remove_joint(j.id); } }
                                        }
                                        if j.id == root.selected_joint_id: Rectangle { x: 0px; y: 0px; width: 2px; height: 100%; background: StudioPalette.accent; }
                                    }
                                }
                                if root.element_tab == "Camadas": VerticalLayout {
                                    spacing: 0px;
                                    for lyr[i] in root.layers_list: Rectangle {
                                        height: 29px;
                                        background: lyr.id == root.selected_layer_id ? StudioPalette.selection : layer-touch.has-hover ? StudioPalette.raised : StudioPalette.surface;
                                        layer-touch := TouchArea {
                                            pointer-event(event) => {
                                                if event.kind == PointerEventKind.down { root.select_layer_range(lyr.id, event.modifiers.shift); }
                                            }
                                        }
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 4px; spacing: 5px;
                                            Image { width: 14px; height: 14px; source: @image-url("../assets/icons/phosphor/svg/regular/stack.svg"); colorize: StudioPalette.muted; }
                                            Text { text: lyr.name; horizontal-stretch: 1; overflow: elide; font-size: 11px; color: lyr.visible ? StudioPalette.text : StudioPalette.muted; vertical-alignment: center; }
                                            StudioButton { has-icon: true; height: 24px; icon: lyr.visible ? @image-url("../assets/icons/phosphor/svg/regular/eye.svg") : @image-url("../assets/icons/phosphor/svg/regular/eye-slash.svg"); description: "Visibilidade de " + lyr.name; clicked => { root.toggle_layer_visibility(lyr.id); } }
                                        }
                                        if lyr.id == root.selected_layer_id: Rectangle { x: 0px; y: 0px; width: 2px; height: 100%; background: StudioPalette.accent; }
                                    }
                                }
                                Rectangle { vertical-stretch: 1; }
                            }
                        }
                        if root.element_tab == "Camadas": HorizontalLayout {
                            padding: 4px; spacing: 3px;
                            StudioButton { has-icon: true; icon: @image-url("../assets/icons/phosphor/svg/regular/arrow-up.svg"); description: "Subir camada"; clicked => { root.move_selected_layer_up(); } }
                            StudioButton { has-icon: true; icon: @image-url("../assets/icons/phosphor/svg/regular/arrow-down.svg"); description: "Descer camada"; clicked => { root.move_selected_layer_down(); } }
                            Rectangle { horizontal-stretch: 1; }
                            StudioButton { label: "Excluir"; clicked => { root.remove_selected_layers(); } }
                        }
                    }
                    if root.dock_tab != "Puppet" && (!root.compact_layout || root.dock_tab == "Inspetor"): VerticalLayout {
                        spacing: 0px;
                        PanelTitle { label: "Transformação"; detail: root.element_tab == "Juntas" ? "Junta" : "Camada"; }
                        ScrollView {
                            preferred-height: root.compact_layout ? 380px : 218px;
                            VerticalLayout {
                                padding: 10px; spacing: 8px;
                                Text { text: root.element_tab == "Juntas" ? root.selected_joint_name : root.selected_layer_name; color: StudioPalette.text; font-weight: 600; font-size: 12px; overflow: elide; }
                                if root.element_tab == "Juntas": VerticalLayout {
                                    spacing: 7px;
                                    Text { text: root.selected_joint_parent == "" ? "Raiz do esqueleto" : "Vínculo: " + root.selected_joint_parent; font-size: 10px; color: StudioPalette.muted; }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        StudioButton { has-icon: true; icon: @image-url("../assets/icons/phosphor/svg/regular/minus.svg"); description: "Diminuir posição X"; quiet: false; clicked => { root.update_joint_pos(root.selected_joint_id, -5, 0); } }
                                        Text { text: "X  " + round(root.selected_joint_x); color: StudioPalette.text; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; }
                                        StudioButton { has-icon: true; icon: @image-url("../assets/icons/phosphor/svg/regular/plus.svg"); description: "Aumentar posição X"; quiet: false; clicked => { root.update_joint_pos(root.selected_joint_id, 5, 0); } }
                                        StudioButton { has-icon: true; icon: @image-url("../assets/icons/phosphor/svg/regular/minus.svg"); description: "Diminuir posição Y"; quiet: false; clicked => { root.update_joint_pos(root.selected_joint_id, 0, -5); } }
                                        Text { text: "Y  " + round(root.selected_joint_y); color: StudioPalette.text; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; }
                                        StudioButton { has-icon: true; icon: @image-url("../assets/icons/phosphor/svg/regular/plus.svg"); description: "Aumentar posição Y"; quiet: false; clicked => { root.update_joint_pos(root.selected_joint_id, 0, 5); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 5px;
                                        Text { text: "Rotação"; color: StudioPalette.muted; font-size: 11px; vertical-alignment: center; }
                                        StudioButton { label: "−15°"; clicked => { root.update_joint_angle(root.selected_joint_id, -0.2618); } }
                                        Text { text: round(root.selected_joint_angle * 57.2958) + "°"; font-size: 11px; color: StudioPalette.text; vertical-alignment: center; }
                                        StudioButton { label: "+15°"; clicked => { root.update_joint_angle(root.selected_joint_id, 0.2618); } }
                                    }
                                    StudioButton { label: "Zerar rotação"; quiet: false; clicked => { root.update_joint_angle(root.selected_joint_id, -root.selected_joint_angle); } }
                                    if root.active_workspace == "Rig": VerticalLayout {
                                        spacing: 5px;
                                        Text { text: "Substituir estrutura por preset"; color: StudioPalette.muted; font-size: 10px; }
                                        HorizontalLayout {
                                            spacing: 3px;
                                            StudioButton { label: "Humanoide"; quiet: false; clicked => { root.set_rig_preset("Humanoid"); } }
                                            StudioButton { label: "Bípede"; quiet: false; clicked => { root.set_rig_preset("BipedSimple"); } }
                                        }
                                        HorizontalLayout {
                                            spacing: 3px;
                                            StudioButton { label: "Quadrúpede"; quiet: false; clicked => { root.set_rig_preset("Quadruped"); } }
                                            StudioButton { label: "Prop"; quiet: false; clicked => { root.set_rig_preset("Prop"); } }
                                        }
                                    }
                                }
                                if root.element_tab == "Camadas": VerticalLayout {
                                    spacing: 6px;
                                    Text { text: "Opacidade  " + round(root.selected_layer_opacity * 100) + "%"; color: StudioPalette.muted; font-size: 11px; }
                                    StudioScrub { description: "Opacidade da camada"; value: root.selected_layer_opacity; changed(value) => { root.update_layer_opacity(root.selected_layer_id, value); } }
                                    Text { text: "Ordem e visibilidade na lista de camadas"; color: StudioPalette.muted; font-size: 10px; wrap: word-wrap; }
                                }
                                Rectangle { vertical-stretch: 1; }
                            }
                        }
                    }
                    if root.dock_tab != "Puppet" && !root.short_layout && !root.compact_layout: VerticalLayout {
                        spacing: 0px;
                        PanelTitle { label: "Navegador"; detail: root.viewport_mode; }
                        Rectangle {
                            height: 112px; background: StudioPalette.field;
                            Image { x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px; source: root.viewport_frame; image-fit: contain; }
                        }
                        HorizontalLayout {
                            padding: 4px;
                            StudioButton { has-icon: true; icon: @image-url("../assets/icons/phosphor/svg/regular/minus.svg"); description: "Diminuir zoom"; clicked => { root.zoom_out(); } }
                            StudioButton { label: round(root.zoom_level * 100) + "%"; clicked => { root.reset_view(); } }
                            StudioButton { has-icon: true; icon: @image-url("../assets/icons/phosphor/svg/regular/plus.svg"); description: "Aumentar zoom"; clicked => { root.zoom_in(); } }
                        }
                    }
                    if root.dock_tab != "Puppet": Rectangle { vertical-stretch: 1; }
                }
                Rectangle { x: 0px; y: 0px; width: 1px; height: 100%; background: StudioPalette.border; }
            }
        }
        Rectangle {
            height: 24px; background: StudioPalette.bg;
            HorizontalLayout {
                padding-left: 10px; padding-right: 10px; spacing: 8px;
                Text { text: root.status_text; color: StudioPalette.muted; font-size: 10px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                if !root.compact_layout: Text { text: root.active_workspace + " · " + root.editor_mode; color: StudioPalette.muted; font-size: 10px; vertical-alignment: center; }
            }
            Rectangle { x: 0px; y: 0px; height: 1px; width: 100%; background: StudioPalette.border; }
        }
    }
    // Aparência é configuração do editor, separada da cor do personagem.
    if root.appearance_open: Rectangle {
        width: 268px; height: 180px; x: root.width - self.width - 8px; y: 42px;
        background: StudioPalette.surface; border-width: 1px; border-color: StudioPalette.border; border-radius: 3px;
        // Intercepta também as áreas vazias; o clique não alcança o documento.
        TouchArea {}
        VerticalLayout {
            padding: 10px; spacing: 8px;
            HorizontalLayout {
                Text { text: "Aparência do editor"; color: StudioPalette.text; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                StudioButton { has-icon: true; icon: @image-url("../assets/icons/phosphor/svg/regular/x.svg"); description: "Fechar aparência"; clicked => { root.appearance_open = false; } }
            }
            HorizontalLayout {
                spacing: 3px;
                StudioButton { label: "Escuro"; active: root.theme_mode == "Dark"; quiet: false; clicked => { root.change_theme("Dark"); } }
                StudioButton { label: "Grafite"; active: root.theme_mode == "Dim"; quiet: false; clicked => { root.change_theme("Dim"); } }
                StudioButton { label: "Claro"; active: root.theme_mode == "Light"; quiet: false; clicked => { root.change_theme("Light"); } }
            }
            Text { text: "Cor de destaque · " + root.accent_name; color: StudioPalette.muted; font-size: 10px; }
            HorizontalLayout {
                spacing: 7px;
                for accent[i] in [{name: "Ciano", color: #06b6d4}, {name: "Azul", color: #3b82f6}, {name: "Violeta", color: #8b5cf6}, {name: "Rosa", color: #ec4899}, {name: "Verde", color: #10b981}, {name: "Ambar", color: #f59e0b}]: StudioSwatch {
                    name: accent.name; swatch-color: accent.color; active: root.accent_name == accent.name;
                    clicked => { root.change_accent(accent.name); }
                }
            }
            Text { text: "Temas alteram as superfícies do editor."; color: StudioPalette.muted; font-size: 10px; }
        }
    }
}
