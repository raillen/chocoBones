// chocoBones Desktop UI em Slint — Estúdio Criativo Adaptativo (Multi-Tema & Ferramentas)
import { Button, VerticalBox, HorizontalBox, Slider, ScrollView, LineEdit } from "std-widgets.slint";

export struct JointRow {
    id: string,
    name: string,
    parent: string,
    color: string,
}

export struct LayerRow {
    id: string,
    name: string,
    joint: string,
    visible: bool,
    locked: bool,
    opacity: float,
}

export component MainWindow inherits Window {
    title: "chocoBones — 2D/3D Puppet & Skeletal Studio";
    preferred-width: 1400px;
    preferred-height: 860px;
    default-font-family: "Inter, system-ui, sans-serif";

    // =========================================================================
    // SISTEMA DE TEMAS E ADAPTABILIDADE DINÂMICA (Dark, Dim/Grafite, Light)
    // =========================================================================
    in-out property <string> theme_mode: "Dark";      // "Dark", "Dim", "Light"
    in-out property <string> accent_name: "Ciano";    // "Ciano", "Azul", "Violeta", "Rosa", "Verde", "Ambar"

    out property <color> col_bg: 
        theme_mode == "Light" ? #f4f4f6 : (theme_mode == "Dim" ? #242428 : #121214);
    out property <color> col_surface: 
        theme_mode == "Light" ? #ffffff : (theme_mode == "Dim" ? #2c2c32 : #18181b);
    out property <color> col_surface_alt: 
        theme_mode == "Light" ? #eaebee : (theme_mode == "Dim" ? #36363d : #222226);
    out property <color> col_field: 
        theme_mode == "Light" ? #f1f2f5 : (theme_mode == "Dim" ? #1f1f23 : #141416);
    out property <color> col_border: 
        theme_mode == "Light" ? #d4d4d8 : (theme_mode == "Dim" ? #3f3f46 : #27272a);
    out property <color> col_text: 
        theme_mode == "Light" ? #18181b : (theme_mode == "Dim" ? #f4f4f5 : #fafafa);
    out property <color> col_text_muted: 
        theme_mode == "Light" ? #71717a : (theme_mode == "Dim" ? #a1a1aa : #a1a1aa);
    out property <color> col_stage_frame: 
        theme_mode == "Light" ? #e2e4e9 : (theme_mode == "Dim" ? #1b1b1e : #09090b);

    out property <color> col_accent: 
        accent_name == "Azul" ? #3b82f6 :
        accent_name == "Violeta" ? #8b5cf6 :
        accent_name == "Rosa" ? #ec4899 :
        accent_name == "Verde" ? #10b981 :
        accent_name == "Ambar" ? #f59e0b :
        #06b6d4; // Ciano clássico do mockup de referência

    out property <color> col_accent_text:
        accent_name == "Ambar" || accent_name == "Ciano" ? #09090b : #ffffff;

    background: col_bg;

    // =========================================================================
    // ESTADO DA APLICAÇÃO
    // =========================================================================
    in-out property <string> active_workspace: "Rig"; // "Montagem", "Rig", "Animacao", "3D", "Foco"
    in-out property <string> active_tool: "Move";     // Move, Rotate, Scale, Pivot, Joint, Bone, Pose, Box, Lasso, Pin, Weight, Eraser
    in-out property <string> viewport_mode: "2D";
    in-out property <image> viewport_frame;
    in-out property <string> status_text: "Pronto — chocoBones Studio Ativo";
    in-out property <float> zoom_level: 1.0;
    in-out property <string> element_tab: "Juntas";   // "Juntas" ou "Camadas"
    in-out property <string> search_filter: "";

    // Coleções Reativas
    in-out property <[JointRow]> joints_list;
    in-out property <[LayerRow]> layers_list;

    // Junta Selecionada
    in-out property <string> selected_joint_id: "root";
    in-out property <string> selected_joint_name: "Centro / quadril";
    in-out property <string> selected_joint_parent: "";
    in-out property <float> selected_joint_x: 256.0;
    in-out property <float> selected_joint_y: 300.0;
    in-out property <float> selected_joint_angle: 0.0;
    in-out property <string> selected_joint_color: "#eab308";
    in-out property <bool> ik_enabled: false;

    // Camada Selecionada
    in-out property <string> selected_layer_id: "";
    in-out property <string> selected_layer_name: "";
    in-out property <float> selected_layer_opacity: 1.0;

    // Linha do Tempo
    in-out property <float> timeline_time: 0.0;
    in-out property <float> timeline_duration: 1.6;
    in-out property <bool> is_playing: true;
    in-out property <string> active_clip_name: "idle";
    in-out property <string> editor_mode: "Animate";

    // Callbacks do Navegador e Ações de Projeto
    callback change_workspace(string);
    callback set_viewport_mode(string);
    callback set_editor_mode(string);
    callback toggle_editor_mode();
    callback change_theme(string);
    callback change_accent(string);
    callback select_tool(string);
    callback set_element_tab(string);
    callback undo();
    callback redo();
    callback new_project();
    callback save_project();
    callback load_project();
    callback export_png();

    // Callbacks de Juntas & Rig
    callback select_joint(string);
    callback add_joint();
    callback remove_joint(string);
    callback update_joint_pos(string, float, float);
    callback update_joint_angle(string, float);
    callback set_rig_preset(string);
    callback toggle_ik();

    // Callbacks de Camadas & Montagem
    callback select_layer(string);
    callback add_layer();
    callback remove_layer(string);
    callback toggle_layer_visibility(string);
    callback update_layer_opacity(string, float);
    callback move_layer(string, float);
    callback move_selected_layer_up();
    callback move_selected_layer_down();
    callback remove_selected_layers();
    callback select_layer_range(string, bool);

    // Callbacks de Animação
    callback toggle_play();
    callback timeline_seek(float);
    callback select_clip(string);
    callback reset_to_rest();

    // Callbacks de Interação com a Viewport
    callback viewport_mouse_down(float, float);
    callback viewport_mouse_up(float, float);
    callback viewport_mouse_move(float, float);
    callback viewport_scroll(float);
    callback zoom_in();
    callback zoom_out();
    callback reset_view();
    callback handle_key(string, bool);

    // Callbacks de Pinos MLS
    callback add_pin(string, float, float) -> string;
    callback delete_pin(string) -> bool;
    callback select_pin(string);
    callback toggle_pin_lock(string) -> bool;
    callback reset_pin(string);
    callback set_pin_anchor(string, string, string);
    callback set_pin_influence(string, float, float, float);

    VerticalBox {
        padding: 0px;
        spacing: 0px;

        // =====================================================================
        // 1. BARRA SUPERIOR PRINCIPAL (PERSONAS / WORKSPACES & AÇÕES GLOBAIS)
        // =====================================================================
        Rectangle {
            height: 44px;
            background: root.col_surface;
            border-width: 1px;
            border-color: root.col_border;

            HorizontalBox {
                padding-left: 10px;
                padding-right: 10px;
                alignment: space-between;

                // Esquerda: Marca e Seletor de Espaços (Pills estilo Canva / Affinity)
                HorizontalBox {
                    spacing: 8px;
                    alignment: start;

                    // Logo Icon Badge
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        background: root.col_accent;

                        Text {
                            text: "🦴";
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "chocoBones";
                        font-weight: 800;
                        font-size: 14px;
                        color: root.col_text;
                        vertical-alignment: center;
                    }

                    Rectangle { width: 6px; }

                    // Espaço: Montagem
                    Rectangle {
                        height: 28px;
                        border-radius: 14px;
                        background: root.active_workspace == "Montagem" ? root.col_accent : root.col_field;
                        border-width: 1px;
                        border-color: root.active_workspace == "Montagem" ? root.col_accent : root.col_border;

                        TouchArea { clicked => { root.change_workspace("Montagem"); } }
                        HorizontalBox {
                            padding-left: 10px; padding-right: 10px;
                            Text {
                                text: "Montagem";
                                font-size: 11px;
                                font-weight: 700;
                                color: root.active_workspace == "Montagem" ? root.col_accent_text : root.col_text;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Espaço: Rig
                    Rectangle {
                        height: 28px;
                        border-radius: 14px;
                        background: root.active_workspace == "Rig" ? root.col_accent : root.col_field;
                        border-width: 1px;
                        border-color: root.active_workspace == "Rig" ? root.col_accent : root.col_border;

                        TouchArea { clicked => { root.change_workspace("Rig"); } }
                        HorizontalBox {
                            padding-left: 10px; padding-right: 10px;
                            Text {
                                text: "Rig Esquelético";
                                font-size: 11px;
                                font-weight: 700;
                                color: root.active_workspace == "Rig" ? root.col_accent_text : root.col_text;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Espaço: Animação
                    Rectangle {
                        height: 28px;
                        border-radius: 14px;
                        background: root.active_workspace == "Animacao" ? root.col_accent : root.col_field;
                        border-width: 1px;
                        border-color: root.active_workspace == "Animacao" ? root.col_accent : root.col_border;

                        TouchArea { clicked => { root.change_workspace("Animacao"); } }
                        HorizontalBox {
                            padding-left: 10px; padding-right: 10px;
                            Text {
                                text: "Animação";
                                font-size: 11px;
                                font-weight: 700;
                                color: root.active_workspace == "Animacao" ? root.col_accent_text : root.col_text;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Espaço: Palco 3D
                    Rectangle {
                        height: 28px;
                        border-radius: 14px;
                        background: root.viewport_mode == "3D" ? root.col_accent : root.col_field;
                        border-width: 1px;
                        border-color: root.viewport_mode == "3D" ? root.col_accent : root.col_border;

                        TouchArea {
                            clicked => {
                                if (root.viewport_mode == "3D") {
                                    root.set_viewport_mode("2D");
                                } else {
                                    root.set_viewport_mode("3D");
                                }
                            }
                        }
                        HorizontalBox {
                            padding-left: 10px; padding-right: 10px;
                            Text {
                                text: root.viewport_mode == "3D" ? "🌐 3D Ativo" : "🌐 Palco 3D";
                                font-size: 11px;
                                font-weight: 700;
                                color: root.viewport_mode == "3D" ? root.col_accent_text : root.col_text;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Espaço: Foco
                    Rectangle {
                        height: 28px;
                        border-radius: 14px;
                        background: root.active_workspace == "Foco" ? root.col_accent : root.col_field;
                        border-width: 1px;
                        border-color: root.active_workspace == "Foco" ? root.col_accent : root.col_border;

                        TouchArea { clicked => { root.change_workspace("Foco"); } }
                        HorizontalBox {
                            padding-left: 10px; padding-right: 10px;
                            Text {
                                text: "Foco";
                                font-size: 11px;
                                font-weight: 700;
                                color: root.active_workspace == "Foco" ? root.col_accent_text : root.col_text;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Direita: Adaptabilidade de Temas, Chips de Acentos e Ações Rápidas
                HorizontalBox {
                    spacing: 8px;
                    alignment: end;

                    // Seletor de Tema (Dark, Dim, Light)
                    Rectangle {
                        height: 26px;
                        border-radius: 13px;
                        background: root.col_field;
                        border-width: 1px;
                        border-color: root.col_border;

                        HorizontalBox {
                            padding-left: 4px; padding-right: 4px; spacing: 2px;
                            Rectangle {
                                width: 22px; height: 20px; border-radius: 10px;
                                background: root.theme_mode == "Dark" ? root.col_accent : #00000000;
                                TouchArea { clicked => { root.change_theme("Dark"); } }
                                Text { text: "🌙"; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Rectangle {
                                width: 22px; height: 20px; border-radius: 10px;
                                background: root.theme_mode == "Dim" ? root.col_accent : #00000000;
                                TouchArea { clicked => { root.change_theme("Dim"); } }
                                Text { text: "🌑"; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Rectangle {
                                width: 22px; height: 20px; border-radius: 10px;
                                background: root.theme_mode == "Light" ? root.col_accent : #00000000;
                                TouchArea { clicked => { root.change_theme("Light"); } }
                                Text { text: "☀️"; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }

                    // Chips de Cor de Destaque (ACCENT_PRESETS)
                    HorizontalBox {
                        spacing: 4px;
                        Rectangle {
                            width: 14px; height: 14px; border-radius: 7px; background: #06b6d4;
                            border-width: root.accent_name == "Ciano" ? 2px : 0px; border-color: root.col_text;
                            TouchArea { clicked => { root.change_accent("Ciano"); } }
                        }
                        Rectangle {
                            width: 14px; height: 14px; border-radius: 7px; background: #3b82f6;
                            border-width: root.accent_name == "Azul" ? 2px : 0px; border-color: root.col_text;
                            TouchArea { clicked => { root.change_accent("Azul"); } }
                        }
                        Rectangle {
                            width: 14px; height: 14px; border-radius: 7px; background: #8b5cf6;
                            border-width: root.accent_name == "Violeta" ? 2px : 0px; border-color: root.col_text;
                            TouchArea { clicked => { root.change_accent("Violeta"); } }
                        }
                        Rectangle {
                            width: 14px; height: 14px; border-radius: 7px; background: #ec4899;
                            border-width: root.accent_name == "Rosa" ? 2px : 0px; border-color: root.col_text;
                            TouchArea { clicked => { root.change_accent("Rosa"); } }
                        }
                        Rectangle {
                            width: 14px; height: 14px; border-radius: 7px; background: #10b981;
                            border-width: root.accent_name == "Verde" ? 2px : 0px; border-color: root.col_text;
                            TouchArea { clicked => { root.change_accent("Verde"); } }
                        }
                        Rectangle {
                            width: 14px; height: 14px; border-radius: 7px; background: #f59e0b;
                            border-width: root.accent_name == "Ambar" ? 2px : 0px; border-color: root.col_text;
                            TouchArea { clicked => { root.change_accent("Ambar"); } }
                        }
                    }

                    Rectangle { width: 4px; }

                    // Ações de Projeto
                    Button { text: "⟲"; clicked => { root.undo(); } }
                    Button { text: "⟳"; clicked => { root.redo(); } }
                    Button { text: "💾"; clicked => { root.save_project(); } }
                    Button { text: "📂"; clicked => { root.load_project(); } }

                    // Botão Destaque Exportar PNG
                    Rectangle {
                        height: 28px;
                        border-radius: 6px;
                        background: root.col_accent;
                        TouchArea { clicked => { root.export_png(); } }
                        HorizontalBox {
                            padding-left: 10px; padding-right: 10px;
                            Text {
                                text: "📸 Exportar PNG";
                                font-size: 11px;
                                font-weight: 700;
                                color: root.col_accent_text;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // =====================================================================
        // 2. BARRA DE OPÇÕES DE CONTEXTO DA FERRAMENTA (Context Bar Superior)
        // =====================================================================
        Rectangle {
            height: 36px;
            background: root.col_surface_alt;
            border-width: 1px;
            border-color: root.col_border;

            HorizontalBox {
                padding-left: 12px;
                padding-right: 12px;
                alignment: space-between;

                HorizontalBox {
                    spacing: 12px;
                    alignment: start;

                    // Indicador da Ferramenta Ativa
                    HorizontalBox {
                        spacing: 4px;
                        Text { text: "Ferramenta:"; font-size: 11px; color: root.col_text_muted; vertical-alignment: center; }
                        Text { text: root.active_tool; font-weight: 700; font-size: 11px; color: root.col_accent; vertical-alignment: center; }
                    }

                    Rectangle { width: 1px; height: 18px; background: root.col_border; }

                    // Alternador IK
                    Button {
                        text: root.ik_enabled ? "IK 2-Bone: ATIVADO" : "IK 2-Bone: DESATIVADO";
                        primary: root.ik_enabled;
                        clicked => { root.toggle_ik(); }
                    }

                    Rectangle { width: 1px; height: 18px; background: root.col_border; }

                    // Presets de Rig Rápidos
                    Text { text: "Rigs:"; font-size: 11px; color: root.col_text_muted; vertical-alignment: center; }
                    Button { text: "Humanoide"; clicked => { root.set_rig_preset("Humanoid"); } }
                    Button { text: "Bípede"; clicked => { root.set_rig_preset("BipedSimple"); } }
                    Button { text: "Quadrúpede"; clicked => { root.set_rig_preset("Quadruped"); } }
                    Button { text: "Prop"; clicked => { root.set_rig_preset("Prop"); } }
                }

                HorizontalBox {
                    spacing: 6px;
                    alignment: end;

                    Text {
                        text: "Zoom: " + round(root.zoom_level * 100) + "%";
                        font-size: 11px;
                        color: root.col_text_muted;
                        vertical-alignment: center;
                    }
                    Button { text: "🔍 -"; clicked => { root.zoom_out(); } }
                    Button { text: "🔍 +"; clicked => { root.zoom_in(); } }
                    Button { text: "⟲ 100%"; clicked => { root.reset_view(); } }
                }
            }
        }

        // =====================================================================
        // 3. CORPO CENTRAL: BARRA LATERAL ESQUERDA + PALCO + PAINEL DIREITO
        // =====================================================================
        HorizontalBox {
            padding: 0px;
            spacing: 0px;

            // -----------------------------------------------------------------
            // RAIL VERTICAL DE FERRAMENTAS ESQUERDA (Estilo Affinity / Illustrator)
            // -----------------------------------------------------------------
            Rectangle {
                width: 46px;
                background: root.col_surface;
                border-width: 1px;
                border-color: root.col_border;

                VerticalBox {
                    padding-top: 8px;
                    padding-bottom: 8px;
                    padding-left: 4px;
                    padding-right: 4px;
                    spacing: 4px;
                    alignment: start;

                    // Tool 1: Mover (V)
                    Rectangle {
                        width: 38px; height: 34px; border-radius: 6px;
                        background: root.active_tool == "Move" ? root.col_surface_alt : #00000000;
                        border-width: root.active_tool == "Move" ? 1px : 0px;
                        border-color: root.col_accent;
                        TouchArea { clicked => { root.select_tool("Move"); } }
                        HorizontalBox {
                            alignment: center; spacing: 0px;
                            Text { text: "↖"; font-size: 15px; font-weight: 700; color: root.active_tool == "Move" ? root.col_accent : root.col_text; vertical-alignment: center; horizontal-alignment: center; }
                        }
                    }

                    // Tool 2: Girar (R)
                    Rectangle {
                        width: 38px; height: 34px; border-radius: 6px;
                        background: root.active_tool == "Rotate" ? root.col_surface_alt : #00000000;
                        border-width: root.active_tool == "Rotate" ? 1px : 0px;
                        border-color: root.col_accent;
                        TouchArea { clicked => { root.select_tool("Rotate"); } }
                        HorizontalBox {
                            alignment: center; spacing: 0px;
                            Text { text: "↺"; font-size: 15px; font-weight: 700; color: root.active_tool == "Rotate" ? root.col_accent : root.col_text; vertical-alignment: center; horizontal-alignment: center; }
                        }
                    }

                    // Tool 3: Escala (S)
                    Rectangle {
                        width: 38px; height: 34px; border-radius: 6px;
                        background: root.active_tool == "Scale" ? root.col_surface_alt : #00000000;
                        border-width: root.active_tool == "Scale" ? 1px : 0px;
                        border-color: root.col_accent;
                        TouchArea { clicked => { root.select_tool("Scale"); } }
                        HorizontalBox {
                            alignment: center; spacing: 0px;
                            Text { text: "⤢"; font-size: 14px; font-weight: 700; color: root.active_tool == "Scale" ? root.col_accent : root.col_text; vertical-alignment: center; horizontal-alignment: center; }
                        }
                    }

                    // Tool 4: Pivô (P)
                    Rectangle {
                        width: 38px; height: 34px; border-radius: 6px;
                        background: root.active_tool == "Pivot" ? root.col_surface_alt : #00000000;
                        border-width: root.active_tool == "Pivot" ? 1px : 0px;
                        border-color: root.col_accent;
                        TouchArea { clicked => { root.select_tool("Pivot"); } }
                        HorizontalBox {
                            alignment: center; spacing: 0px;
                            Text { text: "✛"; font-size: 14px; font-weight: 700; color: root.active_tool == "Pivot" ? root.col_accent : root.col_text; vertical-alignment: center; horizontal-alignment: center; }
                        }
                    }

                    Rectangle { height: 1px; background: root.col_border; }

                    // Tool 5: Juntas (J)
                    Rectangle {
                        width: 38px; height: 34px; border-radius: 6px;
                        background: root.active_tool == "Joint" ? root.col_surface_alt : #00000000;
                        border-width: root.active_tool == "Joint" ? 1px : 0px;
                        border-color: root.col_accent;
                        TouchArea { clicked => { root.select_tool("Joint"); } }
                        HorizontalBox {
                            alignment: center; spacing: 0px;
                            Text { text: "🦴"; font-size: 13px; color: root.active_tool == "Joint" ? root.col_accent : root.col_text; vertical-alignment: center; horizontal-alignment: center; }
                        }
                    }

                    // Tool 6: Criar Osso (C)
                    Rectangle {
                        width: 38px; height: 34px; border-radius: 6px;
                        background: root.active_tool == "CreateBone" ? root.col_surface_alt : #00000000;
                        border-width: root.active_tool == "CreateBone" ? 1px : 0px;
                        border-color: root.col_accent;
                        TouchArea { clicked => { root.select_tool("CreateBone"); } }
                        HorizontalBox {
                            alignment: center; spacing: 0px;
                            Text { text: "➕"; font-size: 12px; color: root.active_tool == "CreateBone" ? root.col_accent : root.col_text; vertical-alignment: center; horizontal-alignment: center; }
                        }
                    }

                    // Tool 7: Pose (Espaço)
                    Rectangle {
                        width: 38px; height: 34px; border-radius: 6px;
                        background: root.active_tool == "Pose" ? root.col_surface_alt : #00000000;
                        border-width: root.active_tool == "Pose" ? 1px : 0px;
                        border-color: root.col_accent;
                        TouchArea { clicked => { root.select_tool("Pose"); } }
                        HorizontalBox {
                            alignment: center; spacing: 0px;
                            Text { text: "🏃"; font-size: 13px; color: root.active_tool == "Pose" ? root.col_accent : root.col_text; vertical-alignment: center; horizontal-alignment: center; }
                        }
                    }

                    // Tool 8: Pinos MLS (N)
                    Rectangle {
                        width: 38px; height: 34px; border-radius: 6px;
                        background: root.active_tool == "Pin" ? root.col_surface_alt : #00000000;
                        border-width: root.active_tool == "Pin" ? 1px : 0px;
                        border-color: root.col_accent;
                        TouchArea { clicked => { root.select_tool("Pin"); } }
                        HorizontalBox {
                            alignment: center; spacing: 0px;
                            Text { text: "📌"; font-size: 13px; color: root.active_tool == "Pin" ? root.col_accent : root.col_text; vertical-alignment: center; horizontal-alignment: center; }
                        }
                    }

                    // Tool 9: Pincel de Pesos (K)
                    Rectangle {
                        width: 38px; height: 34px; border-radius: 6px;
                        background: root.active_tool == "Weight" ? root.col_surface_alt : #00000000;
                        border-width: root.active_tool == "Weight" ? 1px : 0px;
                        border-color: root.col_accent;
                        TouchArea { clicked => { root.select_tool("Weight"); } }
                        HorizontalBox {
                            alignment: center; spacing: 0px;
                            Text { text: "🖌"; font-size: 13px; color: root.active_tool == "Weight" ? root.col_accent : root.col_text; vertical-alignment: center; horizontal-alignment: center; }
                        }
                    }
                }
            }

            // -----------------------------------------------------------------
            // ÁREA CENTRAL: PALCO INFINITO / VIEWPORT RASTERIZADA
            // -----------------------------------------------------------------
            Rectangle {
                background: root.col_stage_frame;

                // Frame de renderização gerado pelo TypeScript
                Image {
                    width: 100%;
                    height: 100%;
                    source: root.viewport_frame;
                }

                // Área de Interação com o Mouse
                TouchArea {
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            root.viewport_mouse_down(self.mouse-x / 1px, self.mouse-y / 1px);
                        }
                        if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                            root.viewport_mouse_up(self.mouse-x / 1px, self.mouse-y / 1px);
                        }
                    }
                    moved => {
                        root.viewport_mouse_move(self.mouse-x / 1px, self.mouse-y / 1px);
                    }
                    scroll-event(event) => {
                        root.viewport_scroll(event.delta-y / 1px);
                        accept
                    }
                }

                // Overlay de Status & Badges da Viewport
                HorizontalBox {
                    alignment: space-between;
                    padding: 10px;

                    // Tag do Modo Ativo
                    Rectangle {
                        background: root.col_surface;
                        border-width: 1px;
                        border-color: root.col_border;
                        border-radius: 6px;
                        height: 28px;
                        padding-left: 10px;
                        padding-right: 10px;

                        HorizontalBox {
                            spacing: 6px;
                            Text {
                                text: root.viewport_mode == "2D" ? "🎨 Palco 2D — Esqueleto Articulado" : "🌐 Palco 3D — Suzanne (Blender OBJ)";
                                font-size: 11px;
                                font-weight: 700;
                                color: root.col_accent;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // -----------------------------------------------------------------
            // PAINEL DIREITO: ESTÚDIO ADAPTATIVO (CARDS / ABAS COMO AFFINITY)
            // -----------------------------------------------------------------
            if root.active_workspace != "Foco": Rectangle {
                width: 320px;
                background: root.col_surface;
                border-width: 1px;
                border-color: root.col_border;

                VerticalBox {
                    padding: 8px;
                    spacing: 8px;

                    // =========================================================
                    // CARD 1: COR & APARÊNCIA (Color & Style)
                    // =========================================================
                    Rectangle {
                        background: root.col_surface_alt;
                        border-width: 1px;
                        border-color: root.col_border;
                        border-radius: 6px;
                        padding: 8px;

                        VerticalBox {
                            spacing: 6px;
                            HorizontalBox {
                                alignment: space-between;
                                Text { text: "COR & ESTILO"; font-size: 11px; font-weight: 700; color: root.col_text_muted; }
                                Rectangle {
                                    width: 16px; height: 16px; border-radius: 8px;
                                    background: root.selected_joint_color == "#eab308" ? #eab308 : (root.selected_joint_color == "#3b82f6" ? #3b82f6 : #10b981);
                                }
                            }

                            HorizontalBox {
                                spacing: 4px;
                                Rectangle { width: 22px; height: 22px; border-radius: 4px; background: #06b6d4; }
                                Rectangle { width: 22px; height: 22px; border-radius: 4px; background: #3b82f6; }
                                Rectangle { width: 22px; height: 22px; border-radius: 4px; background: #8b5cf6; }
                                Rectangle { width: 22px; height: 22px; border-radius: 4px; background: #ec4899; }
                                Rectangle { width: 22px; height: 22px; border-radius: 4px; background: #10b981; }
                                Rectangle { width: 22px; height: 22px; border-radius: 4px; background: #f59e0b; }
                                Rectangle { width: 22px; height: 22px; border-radius: 4px; background: #eab308; }
                                Rectangle { width: 22px; height: 22px; border-radius: 4px; background: #ffffff; }
                            }
                        }
                    }

                    // =========================================================
                    // CARD 2: ELEMENTOS (ABAS JUNTAS / CAMADAS DE SPRITES)
                    // =========================================================
                    Rectangle {
                        background: root.col_surface_alt;
                        border-width: 1px;
                        border-color: root.col_border;
                        border-radius: 6px;
                        padding: 8px;

                        VerticalBox {
                            spacing: 6px;

                            // Abas Superiores
                            HorizontalBox {
                                spacing: 4px;
                                Rectangle {
                                    height: 26px; border-radius: 4px;
                                    background: root.element_tab == "Juntas" ? root.col_accent : root.col_field;
                                    TouchArea { clicked => { root.set_element_tab("Juntas"); } }
                                    HorizontalBox {
                                        padding-left: 8px; padding-right: 8px;
                                        Text { text: "🦴 Juntas"; font-size: 11px; font-weight: 700; color: root.element_tab == "Juntas" ? root.col_accent_text : root.col_text; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    height: 26px; border-radius: 4px;
                                    background: root.element_tab == "Camadas" ? root.col_accent : root.col_field;
                                    TouchArea { clicked => { root.set_element_tab("Camadas"); } }
                                    HorizontalBox {
                                        padding-left: 8px; padding-right: 8px;
                                        Text { text: "🖼 Camadas"; font-size: 11px; font-weight: 700; color: root.element_tab == "Camadas" ? root.col_accent_text : root.col_text; vertical-alignment: center; }
                                    }
                                }

                                Rectangle { width: 4px; }

                                if root.element_tab == "Juntas": Button {
                                    text: "+ Junta";
                                    clicked => { root.add_joint(); }
                                }
                                if root.element_tab == "Camadas": Button {
                                    text: "+ Camada";
                                    clicked => { root.add_layer(); }
                                }
                            }

                            // Conteúdo da Aba JUNTAS
                            if root.element_tab == "Juntas": ScrollView {
                                height: 200px;
                                VerticalBox {
                                    spacing: 3px;
                                    padding: 2px;

                                    for j[idx] in root.joints_list: Rectangle {
                                        height: 30px;
                                        background: j.id == root.selected_joint_id ? root.col_surface : root.col_field;
                                        border-width: j.id == root.selected_joint_id ? 1px : 0px;
                                        border-color: root.col_accent;
                                        border-radius: 4px;

                                        TouchArea { clicked => { root.select_joint(j.id); } }

                                        HorizontalBox {
                                            padding-left: 8px; padding-right: 8px; alignment: space-between;

                                            HorizontalBox {
                                                spacing: 6px;
                                                Rectangle {
                                                    width: 8px; height: 8px; border-radius: 4px;
                                                    background: j.id == "root" ? #eab308 : (j.parent == "root" ? #3b82f6 : #10b981);
                                                }
                                                Text {
                                                    text: j.name;
                                                    font-size: 11px;
                                                    font-weight: j.id == root.selected_joint_id ? 700 : 500;
                                                    color: root.col_text;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            if j.id != "root": Button {
                                                text: "✕";
                                                clicked => { root.remove_joint(j.id); }
                                            }
                                        }
                                    }
                                }
                            }

                            // Conteúdo da Aba CAMADAS
                            if root.element_tab == "Camadas": ScrollView {
                                height: 200px;
                                VerticalBox {
                                    spacing: 3px;
                                    padding: 2px;

                                    for lyr[idx] in root.layers_list: Rectangle {
                                        height: 32px;
                                        background: lyr.id == root.selected_layer_id ? root.col_surface : root.col_field;
                                        border-width: lyr.id == root.selected_layer_id ? 1px : 0px;
                                        border-color: root.col_accent;
                                        border-radius: 4px;

                                        TouchArea { clicked => { root.select_layer(lyr.id); } }

                                        HorizontalBox {
                                            padding-left: 8px; padding-right: 8px; alignment: space-between;

                                            Text {
                                                text: lyr.name;
                                                font-size: 11px;
                                                color: lyr.visible ? root.col_text : root.col_text_muted;
                                                vertical-alignment: center;
                                            }

                                            HorizontalBox {
                                                spacing: 4px;
                                                Button {
                                                    text: lyr.visible ? "👁" : "🕶";
                                                    clicked => { root.toggle_layer_visibility(lyr.id); }
                                                }
                                                Button {
                                                    text: "✕";
                                                    clicked => { root.remove_layer(lyr.id); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // =========================================================
                    // CARD 3: INSPETOR DE TRANSFORMAÇÃO & CINEMÁTICA
                    // =========================================================
                    Rectangle {
                        background: root.col_surface_alt;
                        border-width: 1px;
                        border-color: root.col_border;
                        border-radius: 6px;
                        padding: 8px;

                        VerticalBox {
                            spacing: 6px;

                            HorizontalBox {
                                alignment: space-between;
                                Text {
                                    text: "TRANSFORMAÇÃO";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: root.col_text_muted;
                                }
                                Text {
                                    text: "ID: " + root.selected_joint_id;
                                    font-size: 10px;
                                    color: root.col_accent;
                                }
                            }

                            Text {
                                text: "🦴 " + root.selected_joint_name;
                                font-size: 12px;
                                font-weight: 700;
                                color: root.col_text;
                            }

                            // Ajuste de Posição X e Y
                            HorizontalBox {
                                spacing: 8px;
                                Text { text: "Posição:"; font-size: 11px; color: root.col_text_muted; vertical-alignment: center; }
                                Text { text: "X: " + round(root.selected_joint_x) + "  Y: " + round(root.selected_joint_y); font-size: 11px; font-weight: 700; color: root.col_text; vertical-alignment: center; }
                            }

                            HorizontalBox {
                                spacing: 3px;
                                Button { text: "X -5"; clicked => { root.update_joint_pos(root.selected_joint_id, -5.0, 0.0); } }
                                Button { text: "X +5"; clicked => { root.update_joint_pos(root.selected_joint_id, 5.0, 0.0); } }
                                Button { text: "Y -5"; clicked => { root.update_joint_pos(root.selected_joint_id, 0.0, -5.0); } }
                                Button { text: "Y +5"; clicked => { root.update_joint_pos(root.selected_joint_id, 0.0, 5.0); } }
                            }

                            // Ajuste de Rotação / Ângulo
                            HorizontalBox {
                                spacing: 8px;
                                Text { text: "Ângulo:"; font-size: 11px; color: root.col_text_muted; vertical-alignment: center; }
                                Text { text: round(root.selected_joint_angle * 57.2958) + "°"; font-size: 11px; font-weight: 700; color: root.col_accent; vertical-alignment: center; }
                            }

                            HorizontalBox {
                                spacing: 3px;
                                Button { text: "↺ -15°"; clicked => { root.update_joint_angle(root.selected_joint_id, -0.2618); } }
                                Button { text: "↻ +15°"; clicked => { root.update_joint_angle(root.selected_joint_id, 0.2618); } }
                                Button { text: "Zerar"; clicked => { root.update_joint_angle(root.selected_joint_id, -root.selected_joint_angle); } }
                            }
                        }
                    }
                }
            }
        }

        // =====================================================================
        // 4. LINHA DO TEMPO INFERIOR (QUANDO NO ESPAÇO ANIMAÇÃO)
        // =====================================================================
        if root.active_workspace == "Animacao": Rectangle {
            height: 88px;
            background: root.col_surface;
            border-width: 1px;
            border-color: root.col_border;

            VerticalBox {
                padding: 6px;
                spacing: 4px;

                HorizontalBox {
                    spacing: 8px;
                    alignment: space-between;

                    HorizontalBox {
                        spacing: 4px;

                        Button {
                            text: root.is_playing ? "⏸ Pausar" : "▶ Reproduzir";
                            clicked => { root.toggle_play(); }
                        }
                        Button {
                            text: "⏮ Início";
                            clicked => { root.timeline_seek(0.0); }
                        }
                        Button {
                            text: "Pose Repouso";
                            clicked => { root.reset_to_rest(); }
                        }

                        Rectangle { width: 6px; }

                        Button {
                            text: "Ciclo: Respiração (Idle)";
                            primary: root.active_clip_name == "idle";
                            clicked => { root.select_clip("idle"); }
                        }
                        Button {
                            text: "Ciclo: Caminhada (Walk)";
                            primary: root.active_clip_name == "walk";
                            clicked => { root.select_clip("walk"); }
                        }
                    }

                    Text {
                        text: "Tempo: " + round(root.timeline_time * 100) / 100 + "s / " + root.timeline_duration + "s";
                        color: root.col_accent;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                Slider {
                    minimum: 0.0;
                    maximum: root.timeline_duration;
                    value: root.timeline_time;
                    changed(val) => { root.timeline_seek(val); }
                }
            }
        }

        // =====================================================================
        // 5. BARRA DE STATUS INFERIOR (HINTS & TELEMETRIA)
        // =====================================================================
        Rectangle {
            height: 22px;
            background: root.col_surface_alt;
            border-width: 1px;
            border-color: root.col_border;

            HorizontalBox {
                padding-left: 10px;
                padding-right: 10px;
                alignment: space-between;

                Text {
                    text: root.status_text;
                    font-size: 11px;
                    color: root.col_text_muted;
                    vertical-alignment: center;
                }

                Text {
                    text: "Tema: " + root.theme_mode + " (" + root.accent_name + ") | 60 FPS";
                    font-size: 11px;
                    color: root.col_text_muted;
                    vertical-alignment: center;
                }
            }
        }
    }
}
